# Copy to .env for local development (loaded by dotenv-rails):
#   cp .env.example .env
# Works as-is for local development. Uncomment a line only when you have a
# value for it — never leave "KEY=" empty (Rails would read an empty string).
# In production set these as real environment variables on your host.

# --- Database (development / test) ---
DB_HOST=localhost
DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# Production uses a single URL instead:
# DATABASE_URL=postgres://user:password@host:5432/dayflow

# --- Rails ---
# Generate with: bin/rails secret (required in production)
# SECRET_KEY_BASE=
RAILS_MAX_THREADS=5

# --- Active Record encryption (OAuth refresh tokens) ---
# Generate with: bin/rails db:encryption:init (required in production)
# AR_ENCRYPTION_PRIMARY_KEY=
# AR_ENCRYPTION_DETERMINISTIC_KEY=
# AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Google Sign-In + Calendar (Google Cloud Console > Credentials) ---
# GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_SECRET=
# GOOGLE_IOS_CLIENT_ID=yyy.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=zzz.apps.googleusercontent.com

# --- Sign in with Apple (developer.apple.com > Keys) ---
APPLE_BUNDLE_ID=com.dayflow.app
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Uploads: "local" or a service from config/storage.yml (e.g. amazon) ---
ACTIVE_STORAGE_SERVICE=local

# --- Optional ---
# CORS_ORIGINS=https://admin.dayflow.app
# ENABLE_API_DOCS=true

# --- App Review demo account (bin/rails db:seed) ---
REVIEW_EMAIL=review@dayflow.app
REVIEW_PASSWORD=Review1234
