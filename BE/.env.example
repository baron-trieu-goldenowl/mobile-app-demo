# Copy to .env for local development (loaded by dotenv-rails).
# In production set these as environment variables on your host.

# Database (development); production uses DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DATABASE_URL=

# Rails
SECRET_KEY_BASE=            # bin/rails secret
RAILS_MAX_THREADS=5

# Active Record encryption (OAuth refresh tokens) – bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Google Sign-In + Calendar (Google Cloud Console > Credentials)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple (developer.apple.com > Keys, "Sign in with Apple" key)
APPLE_BUNDLE_ID=com.dayflow.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=          # contents of the .p8 file, newlines as \n

# Uploads: "local" or a service from config/storage.yml (e.g. amazon)
ACTIVE_STORAGE_SERVICE=local

# Optional browser origins allowed by CORS (comma separated)
CORS_ORIGINS=

# App Review demo account (bin/rails db:seed)
REVIEW_EMAIL=review@dayflow.app
REVIEW_PASSWORD=
